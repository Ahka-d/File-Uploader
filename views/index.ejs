<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Log In</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body style="margin-top: 50px;">
  <h1 style="font-size: 36px;">File Uploader</h1>
  <% if (locals.currentUser) {%>
    <h2 style="text-shadow: 1px 1px 3px rgb(0, 0, 0); color: rgba(62, 170, 62, 0.692);">WELCOME BACK <%= currentUser.username %></h1>
    <a href="/log-out">LOG OUT</a>
    <a href="/user-folder/<%= currentUser.id %>">User Folder</a>
    
  <% } else { %>
    <a href="/log-in">LOG IN</a>
    <a href="/sign-up">SIGN UP</a>
    
  <%}%>
</body>
</html>